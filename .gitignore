# Python bytecode and generated package metadata
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# Local environments
.venv/
.venv-*/
venv/
.tox/
.nox/
/env/
/ENV/

# Build products and portable releases
.build/
build/
dist/
releases/*
!releases/README.md
*.spec
*.log

# Local workspace outputs; source and build recipes stay versioned
/work/
/outputs/
/logs/
/test-data*/
/*.zip
/*.7z
/*.rar
/*.whl

# Test, coverage, and static-analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Local editor state and Windows shortcuts
.idea/
.vs/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
*.suo
*.user
*.lnk
*.tmp
*.bak
*~
.DS_Store
Thumbs.db
desktop.ini

# Machine configuration and private runtime data
.env
.env.*
!.env.example
midi_ui_settings.json
downloaded_midis/
catalog_cache/
arrangements/
runs/
self-test*.json
test-data/
audio-engine/
audio-engine.json
audio-models/
audio-checks/
transcriptions/
light-transcriptions/
offline-transcriptions/
node_modules/
src/nte_music_desk/assets/offline_audio/

# Keep docs/, tests/, tools/, .github/, lockfiles, and required assets versioned.
# Runtime .exe/.dll/.bin/.wasm files under assets are not generic build garbage.
